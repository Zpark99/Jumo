# 배포/로컬 실행에 필요한 환경변수 (#20)
# 실제 값은 .env.local(로컬) / Vercel 환경변수(배포)에 넣는다. 이 파일에는 값을 담지 않는다.

# Supabase 프로젝트 URL / anon 키 — Supabase 대시보드 > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service_role 키 — 서버 전용(KIS 토큰 캐싱 #17). 누락 시 시세/차트 동작 안 함. 절대 클라이언트 노출 금지
SUPABASE_SERVICE_ROLE_KEY=

# 한국투자증권(KIS) 시세 API 자격증명 — KIS 개발자센터 발급
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_BASE_URL=

# Vercel Cron 인증 — 목록 시세 일괄 갱신(/api/cron/refresh-quotes, #165). 16자 이상 랜덤.
# Vercel이 Authorization: Bearer <값>으로 보낸다. 비어 있으면 라우트가 항상 401
CRON_SECRET=
